# Şərtlər və döngülər
yas = 18

if yas < 13:
    print("Uşaq")
elif yas < 18:
    print("Yeniyetmə")
elif yas < 65:
    print("Böyük")
else:
    print("Yaşlı")

# while
i = 0
while i < 5:
    print("i =", i)
    i += 1

# for ... range
print("Cüt ədədlər:")
for n in range(0, 11, 2):
    print(n)

# break və continue
for n in range(1, 20):
    if n % 7 == 0:
        print("İlk 7-yə bölünən:", n)
        break

print("Tək ədədlər (5-ə qədər):")
for n in range(0, 10):
    if n % 2 == 0:
        continue
    if n > 5:
        break
    print(n)
